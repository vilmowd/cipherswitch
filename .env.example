# PostgreSQL
POSTGRES_DB=vaultdb
POSTGRES_USER=vaultuser
POSTGRES_PASSWORD=vaultpass
DATABASE_URL=postgresql://vaultuser:vaultpass@localhost:5432/vaultdb

# API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# Stripe — one-time payment per premium use (not a subscription)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
PREMIUM_PRICE_CENTS=500

# Resend (https://resend.com) — required for email delivery
RESEND_API_KEY=re_xxxxxxxx
# Use onboarding@resend.dev for quick tests, or your verified domain:
EMAIL_FROM=CipherSwitch <onboarding@resend.dev>

# Worker
WORKER_POLL_INTERVAL=30
# RELEASE_WEBHOOK_URL=https://hooks.example.com/vault-triggered

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
